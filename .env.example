# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=callconnect
DB_USER=callconnect
DB_PASSWORD=secret

# CallConnect portal
CALLCONNECT_BASE_URL=https://callconnect.proximus.be
CALLCONNECT_LOGIN_PATH=/api/login
CALLCONNECT_DATA_PATH=/api/subscribers
CALLCONNECT_PUSH_PATH=/api/subscribers/{id}
CALLCONNECT_PUSH_METHOD=PUT
CALLCONNECT_LOGIN_FORMAT=json
CALLCONNECT_USERNAME_FIELD=username
CALLCONNECT_PASSWORD_FIELD=password
CALLCONNECT_DATA_KEY=items
CALLCONNECT_ID_FIELD=id
CALLCONNECT_LABEL_FIELD=name
CALLCONNECT_USERNAME=
CALLCONNECT_PASSWORD=
CALLCONNECT_TIMEOUT=30

# Test database (used by phpunit)
TEST_DB_NAME=callconnect_test
